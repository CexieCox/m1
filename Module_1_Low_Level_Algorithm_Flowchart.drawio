<mxfile host="app.diagrams.net"><diagram id="module1_flowchart" name="Module 1 Low-Level Flowchart"><mxGraphModel dx="1740" dy="5300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1740" pageHeight="5300" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="legend_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;dashed=1;dashPattern=6 4;arcSize=3;" parent="1" vertex="1"><mxGeometry x="1140" y="15" width="550" height="95" as="geometry" /></mxCell><mxCell id="legend_box_head" value="&lt;b&gt;FLOWCHART SYMBOLS &amp; CONVENTIONS&lt;/b&gt;&lt;br&gt;TemporalKG Specification" style="text;html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#0F172A;spacingLeft=10;spacingTop=6;" parent="1" vertex="1"><mxGeometry x="1140" y="15" width="550" height="35" as="geometry" /></mxCell><mxCell id="col_left" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;dashed=1;dashPattern=6 4;arcSize=2;" parent="1" vertex="1"><mxGeometry x="30" y="120" width="460" height="5120" as="geometry" /></mxCell><mxCell id="col_left_head" value="&lt;b&gt;MODULE 1 / PIPELINE DATA FLOW ARCHITECTURE&lt;/b&gt;&lt;br&gt;&lt;i&gt;5 Core Pipeline Steps · 1 QA Verification Suite · 1 Downstream Handoff&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#0F172A;spacingLeft=10;spacingTop=6;" parent="1" vertex="1"><mxGeometry x="30" y="120" width="460" height="35" as="geometry" /></mxCell><mxCell id="box_s1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;dashed=1;dashPattern=6 4;arcSize=2;" parent="1" vertex="1"><mxGeometry x="520" y="120" width="1180" height="810" as="geometry" /></mxCell><mxCell id="box_s1_head" value="&lt;b&gt;STEP 1 / DISCOVER REPORT SOURCES&lt;/b&gt;&lt;br&gt;&lt;i&gt;step1_discover_sources.py · Deterministic Link-Safe Enumeration &amp; SHA-256 Prefetch&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#0F172A;spacingLeft=10;spacingTop=6;" parent="1" vertex="1"><mxGeometry x="520" y="120" width="1180" height="35" as="geometry" /></mxCell><mxCell id="box_s2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;dashed=1;dashPattern=6 4;arcSize=2;" parent="1" vertex="1"><mxGeometry x="520" y="960" width="1180" height="810" as="geometry" /></mxCell><mxCell id="box_s2_head" value="&lt;b&gt;STEP 2 / BUILD CANDIDATE INVENTORY&lt;/b&gt;&lt;br&gt;&lt;i&gt;step2_build_inventory.py · Multi-Label Reconciliation &amp; 3-Tier Candidate Screening&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#0F172A;spacingLeft=10;spacingTop=6;" parent="1" vertex="1"><mxGeometry x="520" y="960" width="1180" height="35" as="geometry" /></mxCell><mxCell id="box_s3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;dashed=1;dashPattern=6 4;arcSize=2;" parent="1" vertex="1"><mxGeometry x="520" y="1800" width="1180" height="830" as="geometry" /></mxCell><mxCell id="box_s3_head" value="&lt;b&gt;STEP 3 / STREAM-PARSE &amp; EXTRACT EVIDENCE&lt;/b&gt;&lt;br&gt;&lt;i&gt;step3_scan_evidence.py · Multi-Worker Streaming CAPE Parser &amp; Fact Abstraction&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#0F172A;spacingLeft=10;spacingTop=6;" parent="1" vertex="1"><mxGeometry x="520" y="1800" width="1180" height="35" as="geometry" /></mxCell><mxCell id="box_s4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;dashed=1;dashPattern=6 4;arcSize=2;" parent="1" vertex="1"><mxGeometry x="520" y="2660" width="1180" height="870" as="geometry" /></mxCell><mxCell id="box_s4_head" value="&lt;b&gt;STEP 4 / CONSERVATIVE POLICY DECISION &amp; MANIFEST&lt;/b&gt;&lt;br&gt;&lt;i&gt;step4_decide_and_manifest.py · conservative-v1 Evaluation, Binding Graph &amp; Manifests&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#0F172A;spacingLeft=10;spacingTop=6;" parent="1" vertex="1"><mxGeometry x="520" y="2660" width="1180" height="35" as="geometry" /></mxCell><mxCell id="box_s5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;dashed=1;dashPattern=6 4;arcSize=2;" parent="1" vertex="1"><mxGeometry x="520" y="3560" width="1180" height="810" as="geometry" /></mxCell><mxCell id="box_s5_head" value="&lt;b&gt;STEP 5 / RUN QUALITY ASSURANCE&lt;/b&gt;&lt;br&gt;&lt;i&gt;step5_run_qa.py · QC-01 to QC-15 Verification Suite &amp; Data Integrity Audit&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#0F172A;spacingLeft=10;spacingTop=6;" parent="1" vertex="1"><mxGeometry x="520" y="3560" width="1180" height="35" as="geometry" /></mxCell><mxCell id="box_s6" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;dashed=1;dashPattern=6 4;arcSize=2;" parent="1" vertex="1"><mxGeometry x="520" y="4400" width="1180" height="800" as="geometry" /></mxCell><mxCell id="box_s6_head" value="&lt;b&gt;STEP 6 / EXPORT CANDIDATE DATASET&lt;/b&gt;&lt;br&gt;&lt;i&gt;tools/export_run.py · Byte-for-Byte Verified Handoff to Module 2&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#0F172A;spacingLeft=10;spacingTop=6;" parent="1" vertex="1"><mxGeometry x="520" y="4400" width="1180" height="35" as="geometry" /></mxCell><mxCell id="legend_text_left" value="" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#334155;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="1155" y="50" width="260" height="50" as="geometry" /></mxCell><mxCell id="legend_text_right" value="" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#334155;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="1425" y="50" width="250" height="50" as="geometry" /></mxCell><mxCell id="main_title" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontFamily=Arial;fontSize=18;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=25;" parent="1" vertex="1"><mxGeometry x="30" y="20" width="1080" height="85" as="geometry" /></mxCell><mxCell id="p_in1" value="&lt;b&gt;WinMET Sandbox Traces (Volumes 1-5)&lt;/b&gt;&lt;br&gt;Raw CAPE JSON Execution Reports" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=3;" parent="1" vertex="1"><mxGeometry x="60" y="180" width="400" height="55" as="geometry" /></mxCell><mxCell id="p_in2" value="&lt;b&gt;Metadata Labels &amp; Seed Taxonomy&lt;/b&gt;&lt;br&gt;AVClass + CAPE Detections + Consensus + taxonomy.json" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=3;" parent="1" vertex="1"><mxGeometry x="60" y="250" width="400" height="55" as="geometry" /></mxCell><mxCell id="p_an1" value="&lt;b&gt;DETERMINISTIC LOCATOR CONTRACT&lt;/b&gt;&lt;br&gt;Strict pruning of symlinks, junctions, reparse points (0x400).&lt;br&gt;Physical deduplication via (st_dev, st_ino) keys.&lt;br&gt;SHA256 resolution: filename pattern -&gt; ijson prefetch." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#334155;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="60" y="325" width="400" height="50" as="geometry" /></mxCell><mxCell id="p_s1" value="&lt;b&gt;Step 1: Discover Sources&lt;/b&gt;&lt;br&gt;Path enumeration, link pruning, physical dedup, SHA prefetch" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="80" y="390" width="360" height="65" as="geometry" /></mxCell><mxCell id="p_out1" value="&lt;b&gt;Discovered Sources Inventory&lt;/b&gt;&lt;br&gt;Deduped locators + Prefetched SHA-256" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.08;size=14;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=3;" parent="1" vertex="1"><mxGeometry x="100" y="475" width="320" height="55" as="geometry" /></mxCell><mxCell id="p_an2" value="&lt;b&gt;THREE-TIER SCREENING MODEL&lt;/b&gt;&lt;br&gt;Tiers: Candidate -&gt; Observed -&gt; Payload Execution.&lt;br&gt;Partitions: same_seed_family, one_seed_missing, diff_review.&lt;br&gt;Only seed family members qualify for candidate status." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#334155;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="60" y="555" width="400" height="65" as="geometry" /></mxCell><mxCell id="p_s2" value="&lt;b&gt;Step 2: Build Candidate Inventory&lt;/b&gt;&lt;br&gt;Label store matching, conflict reconciliation, 3-tier partitioning" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="80" y="635" width="360" height="65" as="geometry" /></mxCell><mxCell id="p_out2" value="&lt;b&gt;Candidate Inventory Entries&lt;/b&gt;&lt;br&gt;seed_candidate | candidate | mismatch | not_candidate" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.08;size=14;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=3;" parent="1" vertex="1"><mxGeometry x="100" y="720" width="320" height="55" as="geometry" /></mxCell><mxCell id="p_an3" value="&lt;b&gt;BOUNDED RESOURCE STREAMING&lt;/b&gt;&lt;br&gt;Parse limits: max file bytes, max call bytes, max JSON depth.&lt;br&gt;Multi-worker pool with timeout isolation.&lt;br&gt;Extract process tree, API calls, dropped files, memory dumps." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#334155;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="60" y="800" width="400" height="65" as="geometry" /></mxCell><mxCell id="p_s3" value="&lt;b&gt;Step 3: Multi-Worker Evidence Scan&lt;/b&gt;&lt;br&gt;Streaming parse with ijson, process trees, API call facts" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="80" y="880" width="360" height="65" as="geometry" /></mxCell><mxCell id="p_out3" value="&lt;b&gt;Extracted Evidence Store&lt;/b&gt;&lt;br&gt;evidence/by_report/{report_id}/ (facts, processes, artifacts)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.08;size=14;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=3;" parent="1" vertex="1"><mxGeometry x="100" y="965" width="320" height="55" as="geometry" /></mxCell><mxCell id="p_an4" value="&lt;b&gt;CONSERVATIVE BINDING CONTRACT&lt;/b&gt;&lt;br&gt;observed = supported_family(target) AND trustworthy_binding(target-&gt;proc)&lt;br&gt;           AND runtime_execution(proc) AND NOT conflicts.&lt;br&gt;Binding trust: machine (cmdline/hash) + registry rules + review.&lt;br&gt;payload_execution = observed AND child stage execution observed." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#334155;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="60" y="1045" width="400" height="80" as="geometry" /></mxCell><mxCell id="p_s4" value="&lt;b&gt;Step 4: Conservative Decision &amp; Manifest&lt;/b&gt;&lt;br&gt;Evaluate conservative-v1 policy, link bindings, CSV manifests" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="80" y="1140" width="360" height="65" as="geometry" /></mxCell><mxCell id="p_out4" value="&lt;b&gt;Decision Manifests &amp; JSONL&lt;/b&gt;&lt;br&gt;observed.csv | candidates.csv | all_reports.jsonl" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.08;size=14;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=3;" parent="1" vertex="1"><mxGeometry x="100" y="1225" width="320" height="55" as="geometry" /></mxCell><mxCell id="p_an5" value="&lt;b&gt;INDEPENDENT AUDIT TRAIL&lt;/b&gt;&lt;br&gt;15 independent QC checks (QC-01..QC-15).&lt;br&gt;Atomic SQLite state snapshot.&lt;br&gt;CSV injection protection + UTF-8 BOM encoding." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#334155;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="60" y="1305" width="400" height="65" as="geometry" /></mxCell><mxCell id="p_s5" value="&lt;b&gt;Step 5: Quality Assurance Verification&lt;/b&gt;&lt;br&gt;Execute QC-01 to QC-15 verification checks" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="80" y="1385" width="360" height="65" as="geometry" /></mxCell><mxCell id="p_out5" value="&lt;b&gt;QA Report &amp; Integrity Markers&lt;/b&gt;&lt;br&gt;qa_report.json + .loaderfilter-output.json" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.08;size=14;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=3;" parent="1" vertex="1"><mxGeometry x="100" y="1470" width="320" height="55" as="geometry" /></mxCell><mxCell id="p_an6" value="&lt;b&gt;DOWNSTREAM DATASET EXPORT&lt;/b&gt;&lt;br&gt;Byte-for-byte verified copy of candidate JSON reports.&lt;br&gt;Immutable source run: write to isolated destination directory." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#334155;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="60" y="1550" width="400" height="50" as="geometry" /></mxCell><mxCell id="p_s6" value="&lt;b&gt;Candidate Report Export (tools/export_run.py)&lt;/b&gt;&lt;br&gt;Verified copy, SHA256 integrity check, manifest.jsonl" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="80" y="1615" width="360" height="65" as="geometry" /></mxCell><mxCell id="p_out6" value="&lt;b&gt;Loader-Candidate Reports&lt;/b&gt;&lt;br&gt;export.json + manifest.jsonl + checksums.json + reports/" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.08;size=14;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=3;" parent="1" vertex="1"><mxGeometry x="100" y="1700" width="320" height="55" as="geometry" /></mxCell><mxCell id="p_handoff" value="&lt;b&gt;Module 2: TransitionBuilder&lt;/b&gt;&lt;br&gt;Handoff Loader-Candidate Dataset to Stage Transitions &amp; KG" style="shape=singleArrow;direction=west;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#991B1B;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.8;align=center;spacingLeft=15;" parent="1" vertex="1"><mxGeometry x="80" y="1790" width="360" height="60" as="geometry" /></mxCell><mxCell id="s1_an1" value="&lt;b&gt;INPUT ROOTS &amp; GLOB PATTERNS&lt;/b&gt;&lt;br&gt;Supports multiple roots (WinMET Vols 1-5).&lt;br&gt;Translates include/exclude globs to regex.&lt;br&gt;Prunes output directories to prevent recursion." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#334155;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="540" y="165" width="280" height="85" as="geometry" /></mxCell><mxCell id="s1_an2" value="&lt;b&gt;FILESYSTEM SAFETY GUARDS&lt;/b&gt;&lt;br&gt;Prunes symlinks, junctions, reparse points (0x400).&lt;br&gt;Guards against circular traversal &amp; lock hanging.&lt;br&gt;Validates regular files via stat.S_ISREG." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#334155;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="540" y="270" width="280" height="85" as="geometry" /></mxCell><mxCell id="s1_an3" value="&lt;b&gt;PHYSICAL DEDUPLICATION&lt;/b&gt;&lt;br&gt;Maps (st_dev, st_ino) -&gt; primary DiscoveredFile.&lt;br&gt;Duplicate physical files -&gt; secondary locators.&lt;br&gt;source_id = sha256(root_id + '\0' + relpath)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#334155;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="540" y="375" width="280" height="85" as="geometry" /></mxCell><mxCell id="s1_an4" value="&lt;b&gt;IDENTITY PREFETCH STREAMING&lt;/b&gt;&lt;br&gt;If mode requires target sha256 (auto/report),&lt;br&gt;stream-parse target.file.sha256 via ijson.&lt;br&gt;Bounded by max_file_bytes; avoids full DOM RAM." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#334155;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="540" y="480" width="280" height="85" as="geometry" /></mxCell><mxCell id="s1_start" value="Start" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;" parent="1" vertex="1"><mxGeometry x="1080" y="160" width="160" height="38" as="geometry" /></mxCell><mxCell id="s1_in" value="&lt;b&gt;Input: --config, --limit, input specs&lt;/b&gt;&lt;br&gt;config.inputs roots, include/exclude patterns" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=3;" parent="1" vertex="1"><mxGeometry x="980" y="215" width="360" height="48" as="geometry" /></mxCell><mxCell id="s1_init" value="&lt;b&gt;Initialize RunLogger &amp; PatternSets&lt;/b&gt;&lt;br&gt;Compile regexes; resolve excluded directories" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="980" y="280" width="360" height="44" as="geometry" /></mxCell><mxCell id="s1_d_roots" value="&lt;b&gt;More input roots in config?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=2;" parent="1" vertex="1"><mxGeometry x="1010" y="340" width="300" height="52" as="geometry" /></mxCell><mxCell id="s1_d_walk" value="&lt;b&gt;More directory entries in _walk?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=2;" parent="1" vertex="1"><mxGeometry x="1010" y="410" width="300" height="52" as="geometry" /></mxCell><mxCell id="s1_d_link" value="&lt;b&gt;Is symlink, junction, or reparse point?&lt;/b&gt;&lt;br&gt;FILE_ATTRIBUTE_REPARSE_POINT 0x400" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=2;" parent="1" vertex="1"><mxGeometry x="1020" y="480" width="280" height="50" as="geometry" /></mxCell><mxCell id="s1_prune_link" value="&lt;b&gt;Increment skipped_links&lt;/b&gt;&lt;br&gt;Prune traversal handle" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="1350" y="483" width="200" height="44" as="geometry" /></mxCell><mxCell id="s1_d_match" value="&lt;b&gt;Matches include &amp; not excluded?&lt;/b&gt;&lt;br&gt;Regex check on relative &amp; basename" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=2;" parent="1" vertex="1"><mxGeometry x="1020" y="550" width="280" height="50" as="geometry" /></mxCell><mxCell id="s1_d_phys" value="&lt;b&gt;(st_dev, st_ino) already indexed?&lt;/b&gt;&lt;br&gt;Physical file identity check" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=2;" parent="1" vertex="1"><mxGeometry x="1010" y="620" width="300" height="52" as="geometry" /></mxCell><mxCell id="s1_sec_loc" value="&lt;b&gt;Append secondary locator&lt;/b&gt;&lt;br&gt;duplicate_physical_paths += 1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="1350" y="624" width="200" height="44" as="geometry" /></mxCell><mxCell id="s1_create_file" value="&lt;b&gt;Compute source_id &amp; DiscoveredFile&lt;/b&gt;&lt;br&gt;sha256(root_id + '\0' + relpath); record size, mtime" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="980" y="690" width="360" height="44" as="geometry" /></mxCell><mxCell id="s1_d_prefetch" value="&lt;b&gt;Needs target SHA256 prefetch?&lt;/b&gt;&lt;br&gt;mode == auto/report and missing from filename" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=2;" parent="1" vertex="1"><mxGeometry x="1020" y="750" width="280" height="50" as="geometry" /></mxCell><mxCell id="s1_prefetch_stream" value="&lt;b&gt;Peek target.file.sha256&lt;/b&gt;&lt;br&gt;Stream via ijson up to max_bytes" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="1350" y="753" width="200" height="44" as="geometry" /></mxCell><mxCell id="s1_out" value="&lt;b&gt;Discovered Sources Inventory&lt;/b&gt;&lt;br&gt;DiscoveredFile records + target_shas mapping" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.08;size=14;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=3;" parent="1" vertex="1"><mxGeometry x="980" y="820" width="360" height="48" as="geometry" /></mxCell><mxCell id="s1_end" value="End" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;" parent="1" vertex="1"><mxGeometry x="1080" y="880" width="160" height="36" as="geometry" /></mxCell><mxCell id="s2_an1" value="&lt;b&gt;SEED TAXONOMY CONTRACT&lt;/b&gt;&lt;br&gt;Explicit seed family list: smokeloader, guloader, sload,...&lt;br&gt;Normalizes aliases to canonical identifiers.&lt;br&gt;Casefold canonical resolution contract." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#334155;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="540" y="1005" width="280" height="85" as="geometry" /></mxCell><mxCell id="s2_an2" value="&lt;b&gt;TRIPLE LABEL RECONCILIATION&lt;/b&gt;&lt;br&gt;AVClass + CAPE Detections + Consensus mapping.&lt;br&gt;Per-kind state: present | absent | missing | conflict.&lt;br&gt;Pair state: same_canonical | one_present | diff | unresolved." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#334155;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="540" y="1110" width="280" height="85" as="geometry" /></mxCell><mxCell id="s2_an3" value="&lt;b&gt;THREE-TIER PARTITIONING&lt;/b&gt;&lt;br&gt;Partition 1: same_seed_family (high confidence agreement).&lt;br&gt;Partition 2: one_seed_other_missing (unilateral signal).&lt;br&gt;Partition 3: different_nonmissing_labels_review (conflict)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#334155;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="540" y="1215" width="280" height="85" as="geometry" /></mxCell><mxCell id="s2_an4" value="&lt;b&gt;CANDIDATE ADMISSION PREDICATE&lt;/b&gt;&lt;br&gt;is_candidate = True iff label in seed taxonomy families&lt;br&gt;or consensus indicates loader candidate.&lt;br&gt;Non-loaders categorized as not_candidate." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#334155;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="540" y="1320" width="280" height="85" as="geometry" /></mxCell><mxCell id="s2_start" value="Start" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;" parent="1" vertex="1"><mxGeometry x="1080" y="1000" width="160" height="38" as="geometry" /></mxCell><mxCell id="s2_in" value="&lt;b&gt;Input: Discovered files, taxonomy.json&lt;/b&gt;&lt;br&gt;Label files: AVClass, CAPE, Consensus tables" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=3;" parent="1" vertex="1"><mxGeometry x="980" y="1055" width="360" height="48" as="geometry" /></mxCell><mxCell id="s2_init" value="&lt;b&gt;Initialize LabelStore &amp; Load Taxonomy&lt;/b&gt;&lt;br&gt;Ingest labels; record SHA256 file fingerprints" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="980" y="1120" width="360" height="44" as="geometry" /></mxCell><mxCell id="s2_d_files" value="&lt;b&gt;More discovered files to evaluate?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=2;" parent="1" vertex="1"><mxGeometry x="1010" y="1180" width="300" height="52" as="geometry" /></mxCell><mxCell id="s2_resolve_sha" value="&lt;b&gt;Resolve SHA-256 for File Locator&lt;/b&gt;&lt;br&gt;Check filename -&gt; target_shas -&gt; source_id fallback" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="980" y="1250" width="360" height="44" as="geometry" /></mxCell><mxCell id="s2_lookup_labels" value="&lt;b&gt;Lookup LabelStore &amp; Classify States&lt;/b&gt;&lt;br&gt;Determine kind states: present | absent | missing | conflict" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="980" y="1310" width="360" height="44" as="geometry" /></mxCell><mxCell id="s2_pair_state" value="&lt;b&gt;Compute label_pair_state Contract&lt;/b&gt;&lt;br&gt;same_canonical_family | one_present | different_nonmissing" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="980" y="1370" width="360" height="44" as="geometry" /></mxCell><mxCell id="s2_d_seed" value="&lt;b&gt;Any label maps to seed loader family?&lt;/b&gt;&lt;br&gt;Taxonomy seed loader membership test" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=2;" parent="1" vertex="1"><mxGeometry x="1010" y="1430" width="300" height="52" as="geometry" /></mxCell><mxCell id="s2_cand_yes" value="&lt;b&gt;is_candidate = True&lt;/b&gt;&lt;br&gt;is_seed_candidate = True; partition counter" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="1350" y="1434" width="210" height="44" as="geometry" /></mxCell><mxCell id="s2_d_consensus" value="&lt;b&gt;Consensus or review indicates candidate?&lt;/b&gt;&lt;br&gt;Secondary loader identification check" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=2;" parent="1" vertex="1"><mxGeometry x="1010" y="1500" width="300" height="52" as="geometry" /></mxCell><mxCell id="s2_cand_rev" value="&lt;b&gt;is_candidate = True (Review)&lt;/b&gt;&lt;br&gt;Flagged for human / rule review" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="1350" y="1504" width="210" height="44" as="geometry" /></mxCell><mxCell id="s2_cand_no" value="&lt;b&gt;is_candidate = False&lt;/b&gt;&lt;br&gt;Classify entry as not_candidate" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="980" y="1570" width="360" height="44" as="geometry" /></mxCell><mxCell id="s2_out" value="&lt;b&gt;Candidate Inventory Entries&lt;/b&gt;&lt;br&gt;InventoryResult (seed_candidates, candidates, non_candidates)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.08;size=14;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=3;" parent="1" vertex="1"><mxGeometry x="980" y="1630" width="360" height="48" as="geometry" /></mxCell><mxCell id="s2_end" value="End" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;" parent="1" vertex="1"><mxGeometry x="1080" y="1695" width="160" height="36" as="geometry" /></mxCell><mxCell id="s3_an1" value="&lt;b&gt;SELECTIVE CANDIDATE SCOPE&lt;/b&gt;&lt;br&gt;Default analysis scope: candidates only.&lt;br&gt;Optional scope: all (full corpus audit).&lt;br&gt;Avoids parsing gigabytes of irrelevant traces." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#334155;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="540" y="1845" width="280" height="85" as="geometry" /></mxCell><mxCell id="s3_an2" value="&lt;b&gt;BOUNDED STREAMING (ijson)&lt;/b&gt;&lt;br&gt;Direct streaming over CAPE JSON tokens.&lt;br&gt;Never loads full JSON tree into RAM.&lt;br&gt;max_json_depth guard prevents deep stack overflows." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#334155;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="540" y="1950" width="280" height="85" as="geometry" /></mxCell><mxCell id="s3_an3" value="&lt;b&gt;MULTI-WORKER TIMEOUT GUARDS&lt;/b&gt;&lt;br&gt;ParseScheduler spawns isolated worker pool.&lt;br&gt;Enforces max_file_bytes (200MB) &amp; timeout_seconds.&lt;br&gt;Worker kills hanging JSON parser gracefully." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#334155;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="540" y="2055" width="280" height="85" as="geometry" /></mxCell><mxCell id="s3_an4" value="&lt;b&gt;EVIDENCE ABSTRACTION CONTRACT&lt;/b&gt;&lt;br&gt;Process tree: PID, PPID, cmdline, call_count.&lt;br&gt;API events: process_create, remote_thread, alloc.&lt;br&gt;Synthesizes Fact records with deterministic evidence_id." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#334155;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="540" y="2160" width="280" height="85" as="geometry" /></mxCell><mxCell id="s3_start" value="Start" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;" parent="1" vertex="1"><mxGeometry x="1080" y="1840" width="160" height="38" as="geometry" /></mxCell><mxCell id="s3_in" value="&lt;b&gt;Input: InventoryEntry list, config.resources&lt;/b&gt;&lt;br&gt;Workers count, timeout_seconds, limits" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=3;" parent="1" vertex="1"><mxGeometry x="980" y="1895" width="360" height="48" as="geometry" /></mxCell><mxCell id="s3_filter_tasks" value="&lt;b&gt;Filter Entries by Scope &amp; Build Tasks&lt;/b&gt;&lt;br&gt;Filter scope == candidates; construct worker payload" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="980" y="1960" width="360" height="44" as="geometry" /></mxCell><mxCell id="s3_sched_init" value="&lt;b&gt;Initialize ParseScheduler(workers=N)&lt;/b&gt;&lt;br&gt;Dispatch worker pool; open task communication pipe" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="980" y="2020" width="360" height="44" as="geometry" /></mxCell><mxCell id="s3_d_tasks" value="&lt;b&gt;More parsing tasks in worker queue?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=2;" parent="1" vertex="1"><mxGeometry x="1010" y="2080" width="300" height="52" as="geometry" /></mxCell><mxCell id="s3_d_size" value="&lt;b&gt;File size &lt;= max_file_bytes?&lt;/b&gt;&lt;br&gt;Resource exhaustion guard (default: 200MB)" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=2;" parent="1" vertex="1"><mxGeometry x="1010" y="2150" width="300" height="52" as="geometry" /></mxCell><mxCell id="s3_err_size" value="&lt;b&gt;Record Error: file_too_large&lt;/b&gt;&lt;br&gt;Increment error count; skip file" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="1350" y="2154" width="210" height="44" as="geometry" /></mxCell><mxCell id="s3_d_timeout" value="&lt;b&gt;Parse completes within timeout?&lt;/b&gt;&lt;br&gt;Process execution timeout guard (e.g. 180s)" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=2;" parent="1" vertex="1"><mxGeometry x="1010" y="2220" width="300" height="52" as="geometry" /></mxCell><mxCell id="s3_err_timeout" value="&lt;b&gt;Record Error: timeout_exceeded&lt;/b&gt;&lt;br&gt;Kill worker process; record error" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="1350" y="2224" width="210" height="44" as="geometry" /></mxCell><mxCell id="s3_extract_facts" value="&lt;b&gt;Extract Processes, API Calls &amp; Dropped Files&lt;/b&gt;&lt;br&gt;ijson stream parse; synthesize deterministic Fact records" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="980" y="2290" width="360" height="44" as="geometry" /></mxCell><mxCell id="s3_write_evidence" value="&lt;b&gt;Write ReportEvidence Artifacts&lt;/b&gt;&lt;br&gt;Save to run_dir/evidence/by_report/{report_id}/" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="980" y="2350" width="360" height="44" as="geometry" /></mxCell><mxCell id="s3_store_sqlite" value="&lt;b&gt;Update StateStore SQLite &amp; Completed Count&lt;/b&gt;&lt;br&gt;Upsert report status; commit transaction" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="980" y="2410" width="360" height="44" as="geometry" /></mxCell><mxCell id="s3_out" value="&lt;b&gt;Extracted Evidence Store&lt;/b&gt;&lt;br&gt;evidence/by_report/{id}/ (facts, processes, artifacts)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.08;size=14;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=3;" parent="1" vertex="1"><mxGeometry x="980" y="2470" width="360" height="48" as="geometry" /></mxCell><mxCell id="s3_end" value="End" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;" parent="1" vertex="1"><mxGeometry x="1080" y="2535" width="160" height="36" as="geometry" /></mxCell><mxCell id="s4_an1" value="&lt;b&gt;CONSERVATIVE-V1 PREDICATE&lt;/b&gt;&lt;br&gt;observed = supported_family(target)&lt;br&gt;           AND trustworthy_binding(target-&gt;process)&lt;br&gt;           AND runtime_execution(process)&lt;br&gt;           AND NOT invalidating_conflicts." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#334155;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="540" y="2705" width="280" height="85" as="geometry" /></mxCell><mxCell id="s4_an2" value="&lt;b&gt;BINDING TRUST HIERARCHY&lt;/b&gt;&lt;br&gt;Machine bindings: cmdline hash, injection target.&lt;br&gt;Registry rules: curated technical patterns.&lt;br&gt;Human audit: verified analysts' reviews.&lt;br&gt;Unbound execution -&gt; stays false; flagged review." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#334155;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="540" y="2810" width="280" height="85" as="geometry" /></mxCell><mxCell id="s4_an3" value="&lt;b&gt;RUNTIME EXECUTION PROOF&lt;/b&gt;&lt;br&gt;Target process must have call_count &gt; 0.&lt;br&gt;Verified via successful process_create or&lt;br&gt;remote_thread targeting candidate process PID.&lt;br&gt;No execution call -&gt; not evaluated." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#334155;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="540" y="2915" width="280" height="85" as="geometry" /></mxCell><mxCell id="s4_an4" value="&lt;b&gt;PAYLOAD EXECUTION TIER&lt;/b&gt;&lt;br&gt;payload_execution = observed&lt;br&gt;AND secondary execution of non-target payload&lt;br&gt;(dropped exe, procdump, hollowed child process).&lt;br&gt;Distinguishes initial loader from actual payload." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#334155;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="540" y="3020" width="280" height="85" as="geometry" /></mxCell><mxCell id="s4_an5" value="&lt;b&gt;SECURE MANIFEST GENERATION&lt;/b&gt;&lt;br&gt;UTF-8 BOM encoding for Excel compatibility.&lt;br&gt;Sanitizes leading formula chars (=, +, -, @).&lt;br&gt;Streams all_reports.jsonl with full decision trace." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#334155;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="540" y="3125" width="280" height="85" as="geometry" /></mxCell><mxCell id="s4_start" value="Start" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;" parent="1" vertex="1"><mxGeometry x="1080" y="2700" width="160" height="38" as="geometry" /></mxCell><mxCell id="s4_in" value="&lt;b&gt;Input: StateStore SQLite, run_id, review files&lt;/b&gt;&lt;br&gt;manifest_dir, all_reports.jsonl output path" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=3;" parent="1" vertex="1"><mxGeometry x="980" y="2755" width="360" height="48" as="geometry" /></mxCell><mxCell id="s4_d_reports" value="&lt;b&gt;More reports in StateStore to evaluate?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=2;" parent="1" vertex="1"><mxGeometry x="1010" y="2820" width="300" height="52" as="geometry" /></mxCell><mxCell id="s4_bindings" value="&lt;b&gt;Generate Machine, Registry &amp; Review Bindings&lt;/b&gt;&lt;br&gt;Determine trustworthy_process_indices" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="980" y="2890" width="360" height="44" as="geometry" /></mxCell><mxCell id="s4_runtime_exec" value="&lt;b&gt;Evaluate runtime_execution(process_index)&lt;/b&gt;&lt;br&gt;Inspect process_create &amp; remote_thread success events" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="980" y="2950" width="360" height="44" as="geometry" /></mxCell><mxCell id="s4_d_exec" value="&lt;b&gt;Execution confirmed with trusted binding?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=2;" parent="1" vertex="1"><mxGeometry x="1010" y="3010" width="300" height="52" as="geometry" /></mxCell><mxCell id="s4_d_obs" value="&lt;b&gt;Target SHA matches &amp; Family supported?&lt;/b&gt;&lt;br&gt;Zero invalidating conflicts" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=2;" parent="1" vertex="1"><mxGeometry x="1010" y="3080" width="300" height="52" as="geometry" /></mxCell><mxCell id="s4_set_obs" value="&lt;b&gt;observed = True&lt;/b&gt;&lt;br&gt;execution_status = loader_execution_observed" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="1350" y="3084" width="210" height="44" as="geometry" /></mxCell><mxCell id="s4_d_payload" value="&lt;b&gt;observed == True &amp; Child stage executed?&lt;/b&gt;&lt;br&gt;Procdump, dropped executable, injected child" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=2;" parent="1" vertex="1"><mxGeometry x="1010" y="3150" width="300" height="52" as="geometry" /></mxCell><mxCell id="s4_set_payload" value="&lt;b&gt;payload_execution = True&lt;/b&gt;&lt;br&gt;Second-stage payload execution verified" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="1350" y="3154" width="210" height="44" as="geometry" /></mxCell><mxCell id="s4_classify_dec" value="&lt;b&gt;Assign machine_decision &amp; Quality Flags&lt;/b&gt;&lt;br&gt;loader_run_observed | needs_review | unresolved" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="980" y="3220" width="360" height="44" as="geometry" /></mxCell><mxCell id="s4_write_manifests" value="&lt;b&gt;Generate CSV Manifests &amp; all_reports.jsonl&lt;/b&gt;&lt;br&gt;UTF-8 BOM; CSV anti-formula injection; write 6 CSVs" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="980" y="3280" width="360" height="44" as="geometry" /></mxCell><mxCell id="s4_out" value="&lt;b&gt;Decision Manifests &amp; JSONL&lt;/b&gt;&lt;br&gt;observed.csv, candidates.csv, payload_execution.csv, jsonl" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.08;size=14;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=3;" parent="1" vertex="1"><mxGeometry x="980" y="3340" width="360" height="48" as="geometry" /></mxCell><mxCell id="s4_end" value="End" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;" parent="1" vertex="1"><mxGeometry x="1080" y="3405" width="160" height="36" as="geometry" /></mxCell><mxCell id="s5_an1" value="&lt;b&gt;ISOLATED CHECK EXECUTION&lt;/b&gt;&lt;br&gt;Each check runs in isolated try-except block.&lt;br&gt;Check exception -&gt; recorded as 'error' not abort.&lt;br&gt;Ensures full QA audit visibility even on broken runs." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#334155;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="540" y="3605" width="280" height="85" as="geometry" /></mxCell><mxCell id="s5_an2" value="&lt;b&gt;15 QUALITY CONTROL CHECKS&lt;/b&gt;&lt;br&gt;QC-01..03: Config, taxonomy, label fingerprints.&lt;br&gt;QC-04..06: Source ID uniqueness, derivation, 1:1 map.&lt;br&gt;QC-07..08: Evidence checksums &amp; non-empty schema.&lt;br&gt;QC-09..11: Decision coverage, CSV BOM, row parity.&lt;br&gt;QC-12..13: Hierarchy (observed &lt;= cand &lt;= all) &amp; unres.&lt;br&gt;QC-14..15: Run markers &amp; State/Logs audit trail." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#334155;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="540" y="3710" width="280" height="105" as="geometry" /></mxCell><mxCell id="s5_an3" value="&lt;b&gt;ATOMIC OUTCOME CONTRACT&lt;/b&gt;&lt;br&gt;Overall status is 'pass' iff 0 failures.&lt;br&gt;Emits qa/qa_report.json with full check details.&lt;br&gt;Writes .loaderfilter-output.json completion marker." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#334155;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="540" y="3835" width="280" height="85" as="geometry" /></mxCell><mxCell id="s5_start" value="Start" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;" parent="1" vertex="1"><mxGeometry x="1080" y="3600" width="160" height="38" as="geometry" /></mxCell><mxCell id="s5_in" value="&lt;b&gt;Input: RunLayout, StateStore, Config, run_id&lt;/b&gt;&lt;br&gt;Load state.sqlite, manifests, config snapshots" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=3;" parent="1" vertex="1"><mxGeometry x="980" y="3655" width="360" height="48" as="geometry" /></mxCell><mxCell id="s5_init_log" value="&lt;b&gt;Initialize CheckLog &amp; Load Database Entities&lt;/b&gt;&lt;br&gt;Query sources, reports, report_meta, artifacts" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="980" y="3720" width="360" height="44" as="geometry" /></mxCell><mxCell id="s5_qc_cfg" value="&lt;b&gt;Execute QC-01 to QC-03: Config &amp; Fingerprints&lt;/b&gt;&lt;br&gt;Verify semantic config hash, taxonomy SHA, label files" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="980" y="3780" width="360" height="44" as="geometry" /></mxCell><mxCell id="s5_qc_src" value="&lt;b&gt;Execute QC-04 to QC-06: Identity &amp; Locators&lt;/b&gt;&lt;br&gt;Check unique source_ids, derivation, 1:1 report hash" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="980" y="3840" width="360" height="44" as="geometry" /></mxCell><mxCell id="s5_qc_evi" value="&lt;b&gt;Execute QC-07 to QC-08: Evidence Integrity&lt;/b&gt;&lt;br&gt;Verify evidence files on disk &amp; schema compliance" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="980" y="3900" width="360" height="44" as="geometry" /></mxCell><mxCell id="s5_qc_man" value="&lt;b&gt;Execute QC-09 to QC-11: Manifests &amp; Formats&lt;/b&gt;&lt;br&gt;Check decision coverage, UTF-8 BOM, row count parity" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="980" y="3960" width="360" height="44" as="geometry" /></mxCell><mxCell id="s5_qc_hier" value="&lt;b&gt;Execute QC-12 to QC-15: Hierarchy &amp; Run Markers&lt;/b&gt;&lt;br&gt;observed &lt;= candidate &lt;= all_sources; output markers" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="980" y="4020" width="360" height="44" as="geometry" /></mxCell><mxCell id="s5_d_pass" value="&lt;b&gt;All 15 QC checks passed?&lt;/b&gt;&lt;br&gt;failures_count == 0" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=2;" parent="1" vertex="1"><mxGeometry x="1010" y="4080" width="300" height="52" as="geometry" /></mxCell><mxCell id="s5_fail" value="&lt;b&gt;Return EXIT_INTEGRITY (1)&lt;/b&gt;&lt;br&gt;QA Failed; Log check failures" style="shape=singleArrow;direction=west;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#991B1B;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.8;align=center;spacingLeft=15;" parent="1" vertex="1"><mxGeometry x="1350" y="4084" width="210" height="44" as="geometry" /></mxCell><mxCell id="s5_write_qa" value="&lt;b&gt;Write qa/qa_report.json &amp; Marker&lt;/b&gt;&lt;br&gt;Create .loaderfilter-output.json; commit SQLite run status" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="980" y="4150" width="360" height="44" as="geometry" /></mxCell><mxCell id="s5_out" value="&lt;b&gt;QA Verification Artifacts&lt;/b&gt;&lt;br&gt;qa_report.json + .loaderfilter-output.json" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.08;size=14;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=3;" parent="1" vertex="1"><mxGeometry x="980" y="4210" width="360" height="48" as="geometry" /></mxCell><mxCell id="s5_end" value="End" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;" parent="1" vertex="1"><mxGeometry x="1080" y="4275" width="160" height="36" as="geometry" /></mxCell><mxCell id="s6_an1" value="&lt;b&gt;IMMUTABLE SOURCE RUN&lt;/b&gt;&lt;br&gt;Exports NEVER modify the source run directory.&lt;br&gt;All output written to a fresh destination layout.&lt;br&gt;Generates export.json metadata &amp; checksums.json." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#334155;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="540" y="4445" width="280" height="85" as="geometry" /></mxCell><mxCell id="s6_an2" value="&lt;b&gt;BYTE-FOR-BYTE COPY &amp; VERIFY&lt;/b&gt;&lt;br&gt;Copies raw reports through .tmp files.&lt;br&gt;Calculates SHA-256 of copied bytes.&lt;br&gt;Verifies matches recorded manifest SHA-256.&lt;br&gt;Atomically renames to final destination path." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#334155;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="540" y="4550" width="280" height="85" as="geometry" /></mxCell><mxCell id="s6_an3" value="&lt;b&gt;SELECTION &amp; BUCKETING&lt;/b&gt;&lt;br&gt;Selections: candidates | seed-candidates | observed.&lt;br&gt;Buckets: loader_strict | payload | mixed.&lt;br&gt;Optional --group-by-year partition." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#334155;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="540" y="4655" width="280" height="85" as="geometry" /></mxCell><mxCell id="s6_start" value="Start" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;" parent="1" vertex="1"><mxGeometry x="1080" y="4440" width="160" height="38" as="geometry" /></mxCell><mxCell id="s6_in" value="&lt;b&gt;Input: --run-dir, --dest, --selection, --format&lt;/b&gt;&lt;br&gt;Export options: format=reports, group_by_year=True" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=3;" parent="1" vertex="1"><mxGeometry x="980" y="4495" width="360" height="48" as="geometry" /></mxCell><mxCell id="s6_d_qa" value="&lt;b&gt;Run QA Status == success?&lt;/b&gt;&lt;br&gt;Check .loaderfilter-output.json marker" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=2;" parent="1" vertex="1"><mxGeometry x="1010" y="4560" width="300" height="52" as="geometry" /></mxCell><mxCell id="s6_abort_qa" value="&lt;b&gt;Raise UsageError&lt;/b&gt;&lt;br&gt;Cannot export from unverified run" style="shape=singleArrow;direction=west;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#991B1B;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.8;align=center;spacingLeft=15;" parent="1" vertex="1"><mxGeometry x="1350" y="4564" width="210" height="44" as="geometry" /></mxCell><mxCell id="s6_filter_sources" value="&lt;b&gt;Filter Sources by Selection Scope&lt;/b&gt;&lt;br&gt;e.g. selection == candidates -&gt; filter is_candidate == True" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="980" y="4630" width="360" height="44" as="geometry" /></mxCell><mxCell id="s6_d_reports" value="&lt;b&gt;More selected reports to export?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=2;" parent="1" vertex="1"><mxGeometry x="1010" y="4690" width="300" height="52" as="geometry" /></mxCell><mxCell id="s6_copy_tmp" value="&lt;b&gt;Copy Raw JSON to dest/.tmp&lt;/b&gt;&lt;br&gt;Compute SHA-256 digest of copied bytes" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="980" y="4760" width="360" height="44" as="geometry" /></mxCell><mxCell id="s6_d_sha" value="&lt;b&gt;Copied SHA-256 == Expected SHA-256?&lt;/b&gt;&lt;br&gt;Byte integrity verification guard" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=2;" parent="1" vertex="1"><mxGeometry x="1010" y="4820" width="300" height="52" as="geometry" /></mxCell><mxCell id="s6_abort_sha" value="&lt;b&gt;Raise IntegrityError&lt;/b&gt;&lt;br&gt;Source bytes altered on disk!" style="shape=singleArrow;direction=west;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#991B1B;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.8;align=center;spacingLeft=15;" parent="1" vertex="1"><mxGeometry x="1350" y="4824" width="210" height="44" as="geometry" /></mxCell><mxCell id="s6_rename_atomic" value="&lt;b&gt;Atomic Rename .tmp -&gt; dest/reports/&lt;/b&gt;&lt;br&gt;Record in manifest.jsonl with metadata" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="980" y="4890" width="360" height="44" as="geometry" /></mxCell><mxCell id="s6_write_export_meta" value="&lt;b&gt;Write export.json &amp; checksums.json&lt;/b&gt;&lt;br&gt;Save manifest.jsonl and overall export counts" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;align=center;spacing=4;" parent="1" vertex="1"><mxGeometry x="980" y="4950" width="360" height="44" as="geometry" /></mxCell><mxCell id="s6_out" value="&lt;b&gt;Loader-Candidate Reports&lt;/b&gt;&lt;br&gt;export.json + manifest.jsonl + checksums.json + reports/" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.08;size=14;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strok